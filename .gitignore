# Node.js .gitignore

# Node modules
node_modules/

# Logs
*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build directories
dist/
build/

# Temporary files
tmp/
temp/
.cache/

# IDE and editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS-specific files
.DS_Store
Thumbs.db

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Miscellaneous
*.tgz
*.gz
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Docker files
*.dockerignore
.docker-compose.override.yml

# Yarn integrity file
.yarn-integrity

# NPM debug log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
!package.json
!package-lock.json
!requirements.txt
!*.yml

# InfrIQa generated manifest
.infriqa/


# OpenTofu / Terraform local files
tofu/.terraform/
tofu/*.tfstate
tofu/*.tfstate.*
tofu/tofu.tfvars
tofu/terraform.tfvars
tofu/crash.log
